---
const today = new Date();
const imdb = 'https://www.imdb.com/name/nm3898639/';
const email = 'hello@cinetsvet.com'; // TODO: replace with your real address
---

<footer>
	<div class="inner">
		<p class="copy">
			&copy; {today.getFullYear()} Evgenii Tsvetkov. Director of Photography · Berlin
		</p>
		<nav class="links" aria-label="Footer">
			<a href={imdb} target="_blank" rel="noopener">IMDb</a>
			<a href={`mailto:${email}`}>Email</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		padding: 2.5rem 1.5rem 3rem;
		background: #0b0b0c;
		border-top: 1px solid #222;
		color: #8a867f;
	}
	.inner {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
	}
	.copy {
		margin: 0;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
	}
	.links {
		display: flex;
		gap: 1.6rem;
	}
	.links a {
		color: #d6a05a;
		text-decoration: none;
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.links a:hover {
		color: #fff;
	}
</style>
